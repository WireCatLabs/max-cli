{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@wirecat/cli-core/biome"],
  "files": {
    "includes": ["**", "!**/dist", "!**/node_modules", "!pnpm-lock.yaml"]
  },
  "overrides": [
    {
      "includes": ["src/commands/**", "src/mcp/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/protocol/**",
                      "../protocol/*",
                      "**/spec/**",
                      "../spec/*",
                      "**/generated/**",
                      "../generated/*"
                    ],
                    "message": "commands and the MCP tools speak the domain model; only src/client.ts may reach the protocol, the specification or the generated wrappers"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/domain/models.ts", "src/rendering/**", "src/resolve.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/protocol/**",
                      "../protocol/*",
                      "./protocol/*",
                      "**/spec/**",
                      "../spec/*",
                      "./spec/*",
                      "**/generated/**",
                      "../generated/*",
                      "./generated/*",
                      "**/session/**",
                      "../session/*",
                      "./session/*",
                      "**/commands/**",
                      "../commands/*",
                      "./commands/*",
                      "**/client.js",
                      "../client.js",
                      "./client.js"
                    ],
                    "message": "the messenger boundary (CLI-30): what any messenger CLI could share may not know MAX — no protocol, spec, generated wrappers, session, client or commands"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/bot/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../protocol/**",
                      "../../protocol/**",
                      "../session/**",
                      "../../session/**",
                      "../generated/**",
                      "../../generated/**",
                      "../spec/**",
                      "../../spec/**",
                      "../commands/**",
                      "../../commands/**",
                      "../client.js",
                      "../../client.js"
                    ],
                    "message": "the bot slice talks to the official HTTP Bot API only; the personal account's protocol, session, spec and client stay out of it (ARCHITECTURE §18)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/adapter/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/protocol/**",
                      "**/spec/**",
                      "**/generated/**",
                      "**/commands/**",
                      "**/mcp/**",
                      "**/server/**",
                      "**/bot/**",
                      "**/messenger.js"
                    ],
                    "message": "the adapter maps MaxClient onto the shared messenger port; the wire stays behind src/client.ts, and commands, MCP, max serve, the shared store and the bot are above or beside it"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/session/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/commands/**", "**/mcp/**", "**/bot/**", "**/adapter/**", "**/messenger.js"],
                    "message": "the session is the handshake, the keyring and the state file; it may not know the commands, MCP, the shared store, the adapter or the bot"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/server/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/commands/**",
                      "**/mcp/**",
                      "**/bot/**",
                      "**/adapter/**",
                      "**/messenger.js",
                      "**/program.js"
                    ],
                    "message": "max serve forwards frames and journals sends; it may not reach into the commands, MCP, the adapter, the program or the bot"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/messenger.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/protocol/**",
                      "**/spec/**",
                      "**/generated/**",
                      "**/mcp/**",
                      "**/server/**",
                      "**/bot/**"
                    ],
                    "message": "the messenger hands the shared commands a MaxClient through the adapter; it does not reach the wire, MCP, max serve or the bot"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
