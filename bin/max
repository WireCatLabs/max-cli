#!/usr/bin/env sh
# Runs this worktree's build of `max` with its config, state and cache inside the worktree, in .max/.
#
#   pnpm build
#   bin/max chats list --limit 5
#
# A build with a newer cache schema migrates whatever cache it opens and drops the read history, so
# a build from a worktree never opens the real one. The same variables scope the keyring entry
# (`pathsAreOverridden` in cli-core), so the first run copies the installed max's sessions in —
# a `session start` here would be a new device login on the real account. `pnpm seed:worktree`
# copies them again after a new login.
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
[ -f "$root/dist/bin/max.js" ] || { echo "no build in $root — run pnpm build first" >&2; exit 1; }

[ -d "$root/.max/state" ] || node --experimental-strip-types "$root/scripts/seed-worktree.ts"

export MAX_CONFIG_DIR="$root/.max/config" MAX_STATE_DIR="$root/.max/state" MAX_CACHE_DIR="$root/.max/cache"
# The bots' shared message store, also tg-cli's, lives outside all three; a branch never writes the real one.
export MESSAGING_STORE="$root/.max/messages.db"
exec node "$root/dist/bin/max.js" "$@"
