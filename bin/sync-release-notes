#!/usr/bin/env sh
# Rewrites the notes of every GitHub release from its section of CHANGELOG.md, with the same
# extraction release.yml uses, so an edited changelog reaches the releases people already read.
#
#   bin/sync-release-notes            # every version with a release
#   bin/sync-release-notes 0.19.0     # one version
set -eu

cd "$(dirname "$0")/.."

notes() {
  awk -v v="$1" '$0 ~ "^## "v" " {on=1; next} /^## / && on {exit} on' CHANGELOG.md
}

versions=${1:-$(sed -n 's/^## \([0-9][0-9.]*\) — .*/\1/p' CHANGELOG.md)}

for version in $versions; do
  if ! gh release view "v$version" >/dev/null 2>&1; then
    echo "skip $version — no release v$version" >&2
    continue
  fi
  body=$(notes "$version")
  [ -n "$body" ] || { echo "skip $version — empty section" >&2; continue; }
  printf '%s\n' "$body" | gh release edit "v$version" --notes-file - >/dev/null
  echo "v$version"
done
