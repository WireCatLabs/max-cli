#!/usr/bin/env sh
# Publishes the version in package.json, tags it, creates the GitHub release, installs `max`.
#
#   bin/release           # publishes from GitHub Actions (.github/workflows/release.yml)
#   bin/release --local   # publishes from this machine with the npm token from the keyring
#   bin/release --report <path>   # checks that signed report instead of docs_ai/releases/<version>.md
#
# Steps 3–7 of docs_ai/releasing.md. Run on a clean, up-to-date `main`, after the release skill has
# written and the owner signed docs_ai/releases/<version>.md for this commit. docs_ai/ is a clone of
# the private repository WireCatLabs/cli-private; a fork without it passes its own report. When npm already has
# that version, or a higher one, it merges the next free version into `main` through a pull request,
# carries the report to it and publishes that. A «Не выпущено» section left above the dated, unpublished version
# is folded into it the same way, and the report carried with it. The npm token is never printed — not on success,
# not in an error.
set -eu

usage() { echo "usage: bin/release [--local] [--report <path>]" >&2; exit 2; }
mode=ci
custom=""
pending=""
for arg; do
  if [ -n "$pending" ]; then custom=$arg; pending=""; continue; fi
  case "$arg" in
    --local) mode=local ;;
    --report) pending=1 ;;
    *) usage ;;
  esac
done
[ -z "$pending" ] || usage
case "$custom" in
  "" | /*) ;;
  *) custom="$PWD/$custom" ;;
esac
# The re-exec below runs from the repository root, where a relative --report would point elsewhere.
set --
[ "$mode" = ci ] || set -- --local
[ -z "$custom" ] || set -- "$@" --report "$custom"

cd "$(dirname "$0")/.."
self=$(git hash-object bin/release)
# The fold and land() fast-forward main, and sh reads this file as it goes: a newer bin/release would run half old,
# half new. Run the new one from the start instead: it stops at the report, which names the commit before the fold.
rerun_if_changed() {
  [ "$(git hash-object bin/release)" != "$self" ] || return 0
  [ -z "${WIRECAT_RELEASE_RERUN:-}" ] || { echo "bin/release changed again while releasing — run it again" >&2; exit 1; }
  echo "bin/release changed on main — running the new one"
  export WIRECAT_RELEASE_RERUN=1
  exec ./bin/release "$@"
}

git fetch -q origin
[ "$(git branch --show-current)" = "main" ] || { echo "not on main" >&2; exit 1; }
[ -z "$(git status --porcelain --untracked-files=no)" ] || { echo "uncommitted changes" >&2; exit 1; }
before=$(git rev-parse HEAD)
git merge -q --ff-only origin/main
# The shell is still running the file it read before the merge. On 2026-09-23 that meant the fixed
# check of 080a5c4 never ran: the checkout was behind, and the old script published and gave up.
[ "$(git rev-parse HEAD)" = "$before" ] || exec ./bin/release "$@"
# The workflow publishes origin/main, so a local commit not pushed yet would silently not ship.
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || { echo "main is ahead of origin/main — push first" >&2; exit 1; }
# One release at a time per package on this machine: two sessions published at once on 2026-10-08.
. ./config/wirecat/release-lock.sh
wirecat_release_lock
version=$(node -p 'require("./package.json").version')
# `npm view` rather than a curl of the registry document: that document is served through a CDN
# cache, and on 2026-09-22 the script twice stopped after publishing, before the tag.
published() {
  npm view "@wirecat/max-cli@$version" version --prefer-online >/dev/null 2>&1
}

# The judgement half of the release — changelog, docs, requirements, live scenarios — is the release
# skill's, and its report is the only record that it ran for this exact commit.
if [ -n "$custom" ]; then
  report=$custom
elif [ -d docs_ai ]; then
  report="docs_ai/releases/$version.md"
else
  echo "no docs_ai/ — release reports live in the private repository WireCatLabs/cli-private, cloned into" \
    "docs_ai/, as releases/$version.md. A fork passes its own signed report: bin/release --report <path>" >&2
  exit 1
fi
[ -f "$report" ] || { echo "no release report $report — run the release skill first" >&2; exit 1; }
grep -qx "Commit: $(git rev-parse HEAD)" "$report" || { echo "$report is for another commit than HEAD" >&2; exit 1; }
# A date, not the template's placeholder, so a report copied from the template does not pass as signed.
grep -Eq '^Signed off: [0-9]{4}-[0-9]{2}-[0-9]{2}' "$report" || { echo "$report is not signed off by the owner" >&2; exit 1; }

# Released already: the renumbering below would relabel that version's notes and publish the same code again.
if [ -n "$(git tag -l "v$version")" ] && [ "$(git rev-list -n 1 "v$version")" = "$(git rev-parse HEAD)" ]; then
  echo "v$version is this very commit — nothing new to release" >&2
  exit 1
fi

# main takes changes only through a pull request (the repository's ruleset).
land() {
  branch=$1 title=$2 body=$3
  git switch -q -c "$branch"
  git commit -q -am "$title" -m "$body"
  git push -q -u origin "$branch"
  git switch -q main
  pr=$(gh pr create --base main --head "$branch" --title "$title" --body "$body")
  # Checks register a few seconds after the pull request; --watch with none exits at once.
  for _ in $(seq 30); do
    [ "$(gh pr checks "$pr" --json name --jq length 2>/dev/null || echo 0)" -gt 0 ] && break
    sleep 2
  done
  gh pr checks "$pr" --watch --fail-fast >/dev/null ||
    { echo "checks failed on $pr — nothing is published" >&2; exit 1; }
  gh pr merge "$pr" --squash --delete-branch --subject "$title (#${pr##*/})"
  git fetch -q origin
  git merge -q --ff-only origin/main
  [ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] ||
    { echo "main is not origin/main after $pr" >&2; exit 1; }
}

# The report stays the owner's: it is checked above for the commit they signed, and carried to the
# new HEAD only when the commits since change nothing but the number and the changelog.
committed() {
  [ -n "$custom" ] || git -C docs_ai ls-files --error-unmatch "releases/$version.md" >/dev/null 2>&1 ||
    { echo "$report is not committed in docs_ai — commit it first" >&2; exit 1; }
  signed=$(git rev-parse HEAD)
}
carry() {
  to=$1 note=$2 subject=$3
  extra=$(git diff --name-only "$signed" HEAD | grep -vx -e package.json -e src/version.ts -e CHANGELOG.md || true)
  [ -z "$extra" ] || { echo "main changed more than the number since $report was signed: $extra" >&2; exit 1; }
  if [ -z "$custom" ] && [ "$to" != "$version" ]; then
    git -C docs_ai mv "releases/$version.md" "releases/$to.md"
    report="docs_ai/releases/$to.md"
  fi
  node -e 'const fs = require("fs"); const [file, o, n, signed, head, note] = process.argv.slice(1)
    const text = fs.readFileSync(file, "utf8").replace(`# ${o}\n`, `# ${n}\n`)
    const carried = text.replace(`Commit: ${signed}`, `Commit: ${head}`).trimEnd()
    fs.writeFileSync(file, `${carried}\n\n${note} Signed for ${signed}; ${head} changes only the number and the changelog.\n`)' \
    "$report" "$version" "$to" "$signed" "$(git rev-parse HEAD)" "$note"
  if [ -z "$custom" ]; then
    git -C docs_ai commit -q -m "$subject" -- "releases/$version.md" "releases/$to.md"
    git -C docs_ai push -q || echo "docs_ai: the carried report is committed but not pushed — push docs_ai" >&2
  else
    echo "$report now reports $to at $(git rev-parse HEAD) — commit it yourself" >&2
  fi
}

# A pull request checked before the last release and merged after it put its entry in that release's section;
# restore moves it to «Не выпущено», so the fold below brings it into this version, and the report goes with it.
signed_at=$(git rev-parse HEAD)
restored=$(npx -y -p @wirecat/cli-base@0.55.0 cli-dev changelog restore --land --unreleased "Не выпущено")
if [ -n "$restored" ]; then
  echo "$restored"
  committed
  signed=$signed_at
  carry "$version" "bin/release restored the last release's changelog section to its tag." \
    "docs(releases): $version carried to the restored changelog by bin/release"
fi
rerun_if_changed "$@"

# A session that merges after the version was dated, but before it was published, adds «Не выпущено» above it.
# cli-dev is pinned rather than taken from the dependencies: cli-core accepts only an older cli-base.
# --land folds on a fresh main through its own pull request, and folds again once if main moves under it.
folded=""
if ! published; then
  signed_at=$(git rev-parse HEAD)
  folded=$(npx -y -p @wirecat/cli-base@0.36.0 cli-dev changelog fold --land --version "$version" --unreleased "Не выпущено")
fi
if [ -n "$folded" ]; then
  echo "$folded"
  committed
  signed=$signed_at
  carry "$version" "bin/release folded «Не выпущено» into $version." \
    "docs(releases): $version carried to the folded changelog by bin/release"
fi
rerun_if_changed "$@"

# Two sessions preparing the same number is normal; the second takes the next free one (2026-09-29).
latest=$(npm view @wirecat/max-cli version --prefer-online 2>/dev/null || true)
versions=$(npm view @wirecat/max-cli versions --json --prefer-online 2>/dev/null || true)
next=$(node scripts/next-version.mjs "$version" "$latest" "$versions")
if [ "$next" != "$version" ]; then
  if published; then why="$version is already on npm"; else why="$version is not above npm's latest $latest"; fi
  echo "$why — publishing $next instead"
  committed
  # A version npm already has keeps its section; «Не выпущено» becomes the new version. Otherwise the
  # prepared section that another session's release took moves to the next number.
  taken=$(published && echo 1 || true)
  node -e 'const fs = require("fs"); const [o, n, taken] = process.argv.slice(1)
    const swap = (file, from, to) => fs.writeFileSync(file, fs.readFileSync(file, "utf8").replace(from, to))
    const today = new Date().toLocaleDateString("ru-RU", { timeZone: "Europe/Madrid" })
    swap("package.json", `"version": "${o}"`, `"version": "${n}"`)
    if (taken) swap("CHANGELOG.md", "\n## Не выпущено\n", `\n## ${n} — ${today}\n`)
    else swap("CHANGELOG.md", `\n## ${o} — `, `\n## ${n} — `)' "$version" "$next" "$taken"
  pnpm exec cli-dev version --sync >/dev/null
  body="bin/release: $why. Only the number changes: package.json, src/version.ts, the CHANGELOG heading."
  land "release/$next" "chore(release): $next" "$body"
  carry "$next" "Renumbered by bin/release: $version → $next ($why)." \
    "docs(releases): $version → $next, renumbered by bin/release"
  rerun_if_changed "$@"
  version=$next
fi
if published; then
  echo "$version is already on npm — raise the version first" >&2
  exit 1
fi

# The fold fast-forwards main even when it has nothing to fold, so HEAD can be a commit nobody signed.
grep -qx "Commit: $(git rev-parse HEAD)" "$report" ||
  { echo "main moved past the commit $report was signed for — sign the new HEAD and run again" >&2; exit 1; }

echo "== checks for $version =="
pnpm install --frozen-lockfile
pnpm release:check

install() {
  echo "== installing =="
  pnpm add -g "@wirecat/max-cli@$version"
  cd /tmp && max -V
}

if [ "$mode" = ci ]; then
  last_run() {
    gh run list --workflow release.yml --branch main --event workflow_dispatch --limit 1 \
      --json databaseId --jq '.[0].databaseId // ""'
  }
  previous=$(last_run)
  echo "== starting the release workflow for $version =="
  gh workflow run release.yml --ref main -f commit="$(git rev-parse HEAD)"
  run=""
  for _ in $(seq 30); do
    run=$(last_run)
    [ -n "$run" ] && [ "$run" != "$previous" ] && break
    run=""
    sleep 2
  done
  [ -n "$run" ] || { echo "the release workflow did not start within a minute — see gh run list --workflow release.yml" >&2; exit 1; }
  gh run watch "$run" --exit-status
  git fetch -q --tags origin
  install
  exit 0
fi

token=$(secret-tool lookup service npm account leemour) || { echo "no npm token in the keyring (service=npm account=leemour)" >&2; exit 1; }
[ -n "$token" ] || { echo "the keyring entry is empty" >&2; exit 1; }

echo "== publishing $version =="
# Our own checks above stand in for pnpm's: it counts untracked files as a dirty tree.
NPM_TOKEN="$token" pnpm publish --access public --no-git-checks

echo "== waiting for npm to show $version (up to three minutes) =="
seen=""
for _ in $(seq 36); do
  if published; then seen=1; break; fi
  sleep 5
done
[ -n "$seen" ] || { echo "npm does not show $version after three minutes — not tagging; steps 6–7 of docs_ai/releasing.md finish it by hand" >&2; exit 1; }

echo "== tag and release v$version =="
git tag -a "v$version" -m "$version"
git push -q origin "v$version"
awk -v v="$version" '$0 ~ "^## "v" " {on=1; next} /^## / && on {exit} on' CHANGELOG.md |
  gh release create "v$version" --title "$version" --notes-file -

install
