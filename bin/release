#!/usr/bin/env sh
# Publishes the version in package.json, tags it, creates the GitHub release, installs `max`.
#
#   bin/release           # publishes from GitHub Actions (.github/workflows/release.yml)
#   bin/release --local   # publishes from this machine with the npm token from the keyring
#
# Steps 3–7 of docs_ai/releasing.md. Run on a clean, up-to-date `main`, after the release skill has
# written and the owner signed docs_ai/releases/<version>.md for this commit. The npm token is never
# printed — not on success, not in an error.
set -eu

cd "$(dirname "$0")/.."

mode=ci
case "${1:-}" in
  "") ;;
  --local) mode=local ;;
  *) echo "usage: bin/release [--local]" >&2; exit 2 ;;
esac

git fetch -q origin
[ "$(git branch --show-current)" = "main" ] || { echo "not on main" >&2; exit 1; }
[ -z "$(git status --porcelain --untracked-files=no)" ] || { echo "uncommitted changes" >&2; exit 1; }
before=$(git rev-parse HEAD)
git merge -q --ff-only origin/main
# The shell is still running the file it read before the merge. On 2026-09-23 that meant the fixed
# check of 080a5c4 never ran: the checkout was behind, and the old script published and gave up.
[ "$(git rev-parse HEAD)" = "$before" ] || exec "$0" "$@"
# The workflow publishes origin/main, so a local commit not pushed yet would silently not ship.
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || { echo "main is ahead of origin/main — push first" >&2; exit 1; }

version=$(node -p 'require("./package.json").version')
# `npm view` rather than a curl of the registry document: that document is served through a CDN
# cache, and on 2026-09-22 the script twice stopped after publishing, before the tag.
published() {
  npm view "@leemour/max-cli@$version" version --prefer-online >/dev/null 2>&1
}
if published; then
  echo "$version is already on npm — raise the version first" >&2
  exit 1
fi

# The judgement half of the release — changelog, docs, requirements, live scenarios — is the release
# skill's, and its report is the only record that it ran for this exact commit.
report="docs_ai/releases/$version.md"
[ -f "$report" ] || { echo "no release report $report — run the release skill first" >&2; exit 1; }
grep -qx "Commit: $(git rev-parse HEAD)" "$report" || { echo "$report is for another commit than HEAD" >&2; exit 1; }
# A date, not the template's placeholder, so a report copied from the template does not pass as signed.
grep -Eq '^Signed off: [0-9]{4}-[0-9]{2}-[0-9]{2}' "$report" || { echo "$report is not signed off by the owner" >&2; exit 1; }

echo "== checks for $version =="
pnpm install --frozen-lockfile
pnpm release:check

install() {
  echo "== installing =="
  pnpm add -g "@leemour/max-cli@$version"
  cd /tmp && max -V
}

if [ "$mode" = ci ]; then
  last_run() {
    gh run list --workflow release.yml --branch main --event workflow_dispatch --limit 1 \
      --json databaseId --jq '.[0].databaseId // ""'
  }
  previous=$(last_run)
  echo "== starting the release workflow for $version =="
  gh workflow run release.yml --ref main
  run=""
  for _ in $(seq 30); do
    run=$(last_run)
    [ -n "$run" ] && [ "$run" != "$previous" ] && break
    run=""
    sleep 2
  done
  [ -n "$run" ] || { echo "the release workflow did not start within a minute — see gh run list --workflow release.yml" >&2; exit 1; }
  gh run watch "$run" --exit-status
  git fetch -q --tags origin
  install
  exit 0
fi

token=$(secret-tool lookup service npm account leemour) || { echo "no npm token in the keyring (service=npm account=leemour)" >&2; exit 1; }
[ -n "$token" ] || { echo "the keyring entry is empty" >&2; exit 1; }

echo "== publishing $version =="
# Our own checks above stand in for pnpm's: it counts untracked files as a dirty tree.
NPM_TOKEN="$token" pnpm publish --access public --no-git-checks

echo "== waiting for npm to show $version (up to three minutes) =="
seen=""
for _ in $(seq 36); do
  if published; then seen=1; break; fi
  sleep 5
done
[ -n "$seen" ] || { echo "npm does not show $version after three minutes — not tagging; steps 6–7 of docs_ai/releasing.md finish it by hand" >&2; exit 1; }

echo "== tag and release v$version =="
git tag -a "v$version" -m "$version"
git push -q origin "v$version"
awk -v v="$version" '$0 ~ "^## "v" " {on=1; next} /^## / && on {exit} on' CHANGELOG.md |
  gh release create "v$version" --title "$version" --notes-file -

install
