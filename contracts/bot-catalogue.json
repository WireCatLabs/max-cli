  "chats moderate": {
    "writes": true,
    "input": {
      "type": "object",
      "properties": {
        "chat": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!-$)[\\s\\S]+$",
          "description": "a group's id, or the title of a group this bot has seen"
        },
        "since_time": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!-$)[\\s\\S]+$",
          "description": "judge what came after this ISO 8601 time, or 2h / 1d ago; the saved point stays"
        },
        "dry_run": {
          "type": "boolean",
          "description": "judge and plan; do nothing"
        },
        "no_block": {
          "type": "boolean",
