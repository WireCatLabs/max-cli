{
  "name": "@leemour/max-cli",
  "version": "0.25.0",
  "description": "MAX Messenger bots through the official Bot API, and a personal MAX account, from the terminal — built for agents and scripts",
  "license": "MIT",
  "author": "Viacheslav Ptsarev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leemour/max-cli.git"
  },
  "type": "module",
  "engines": {
    "node": "^22.16.0 || >=24"
  },
  "packageManager": "pnpm@11.20.0",
  "bin": {
    "max": "dist/bin/max.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build",
    "generate": "node --experimental-strip-types scripts/bot/generate.ts && pnpm build && node --experimental-strip-types scripts/generate.ts && node --experimental-strip-types scripts/commands.ts",
    "bot:spec:sync": "node --experimental-strip-types scripts/bot/sync-spec.ts",
    "bot:generate": "node --experimental-strip-types scripts/bot/generate.ts",
    "bot:generate:check": "node --experimental-strip-types scripts/bot/generate.ts --check",
    "typecheck": "tsc --build --force --emitDeclarationOnly && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:matrix": "vitest run >/dev/null && pnpm build >/dev/null && cli-dev test-matrix --program dist/program.js --untested scripts/test-matrix-untested.ts --name max --check",
    "test:slow": "vitest run --reporter=json --outputFile=coverage/tests.json >/dev/null; cli-dev slow-tests",
    "smoke:bun": "bun run scripts/smoke.ts",
    "mcp:tools": "node --experimental-strip-types scripts/mcp-tools.ts",
    "smoke:live": "pnpm build && node --experimental-strip-types scripts/smoke-live.ts",
    "release:check": "pnpm build && node --experimental-strip-types scripts/release-check.ts",
    "docs:check": "cli-dev docs-check --rules scripts/release/checks.ts --pages && cspell --no-progress --no-summary README.md 'docs/*.md' && rumdl check --config node_modules/@leemour/cli-core/config/rumdl.toml README.md docs/*.md",
    "parity:check": "pnpm build && node dist/bin/max.js commands --json | cli-messaging-parity max && node dist/bin/max.js commands --json | cli-messaging-parity max --pages README.md docs/*.md",
    "version:check": "cli-dev version",
    "version:sync": "cli-dev version --sync",
    "seed:worktree": "node --experimental-strip-types scripts/seed-worktree.ts --force",
    "probe:ids": "pnpm build && node --experimental-strip-types scripts/id-shape.ts",
    "probe:download": "pnpm build && node --experimental-strip-types scripts/probe-download.ts",
    "probe:upload": "pnpm build && node --experimental-strip-types scripts/probe-upload.ts",
    "probe:reply": "pnpm build && node --experimental-strip-types scripts/probe-reply.ts",
    "probe:scheduled": "pnpm build && node --experimental-strip-types scripts/probe-scheduled.ts",
    "probe:delete": "pnpm build && node --experimental-strip-types scripts/probe-delete.ts",
    "probe:edits": "pnpm build && node --experimental-strip-types scripts/probe-edits.ts",
    "probe:attachments": "pnpm build && node --experimental-strip-types scripts/probe-attachments.ts",
    "verify:live": "pnpm build && node --experimental-strip-types scripts/verify-commands.ts",
    "prepare": "lefthook install || true",
    "secrets:scan": "gitleaks git --no-banner --redact .",
    "prepack": "rm -rf dist tsconfig.tsbuildinfo && pnpm build",
    "probe:contacts": "pnpm build && node --experimental-strip-types scripts/probe-contacts.ts",
    "probe:reactions": "pnpm build && node --experimental-strip-types scripts/probe-reactions.ts",
    "probe:message-shapes": "pnpm build && node --experimental-strip-types scripts/probe-message-shapes.ts",
    "probe:token": "pnpm build && node --experimental-strip-types scripts/probe-token.ts",
    "probe:inbox": "pnpm build && node --experimental-strip-types scripts/probe-inbox.ts",
    "probe:edit-pin-forward": "pnpm build && node --experimental-strip-types scripts/probe-edit-pin-forward.ts",
    "probe:groups": "pnpm build && node --experimental-strip-types scripts/probe-groups.ts",
    "probe:members": "pnpm build && node --experimental-strip-types scripts/probe-members.ts",
    "probe:account": "pnpm build && node --experimental-strip-types scripts/probe-account.ts",
    "probe:read-mark": "pnpm build && node --experimental-strip-types scripts/probe-read-mark.ts",
    "probe:pre-release": "pnpm build && node --experimental-strip-types scripts/probe-pre-release.ts",
    "probe:control": "pnpm build && node --experimental-strip-types scripts/probe-control.ts",
    "probe:member-list": "pnpm build && node --experimental-strip-types scripts/probe-member-list.ts",
    "probe:admin-rights": "pnpm build && node --experimental-strip-types scripts/probe-admin-rights.ts",
    "probe:message-count": "pnpm build && node --experimental-strip-types scripts/probe-message-count.ts",
    "probe:media-send": "pnpm build && node --experimental-strip-types scripts/probe-media-send.ts",
    "probe:video": "pnpm build && node --experimental-strip-types scripts/probe-video.ts",
    "probe:voice": "pnpm build && node --experimental-strip-types scripts/probe-voice.ts",
    "probe:polls": "pnpm build && node --experimental-strip-types scripts/probe-polls.ts",
    "probe:profile": "pnpm build && node --experimental-strip-types scripts/probe-profile.ts",
    "probe:bot:me": "pnpm build && node --experimental-strip-types scripts/probe-bot-me.ts"
  },
  "dependencies": {
    "@leemour/cli-core": "0.17.0",
    "@leemour/cli-messaging": "0.135.0",
    "@modelcontextprotocol/server": "2.1.0",
    "@msgpack/msgpack": "3.1.3",
    "@valibot/to-json-schema": "1.8.0",
    "commander": "15.0.0",
    "lossless-json": "4.3.1",
    "ogg-opus-decoder": "1.7.5",
    "qrcode-generator": "2.0.4",
    "sherpa-onnx": "1.13.8",
    "string-width": "8.3.0",
    "valibot": "1.5.0",
    "wrap-ansi": "10.0.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@cspell/dict-en-gb": "^5.0.34",
    "@cspell/dict-ru_ru": "^2.3.2",
    "@modelcontextprotocol/client": "~2.1.0",
    "@types/node": "^22.20.4",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.2",
    "cspell": "^10.3.6",
    "lefthook": "^2.1.8",
    "rumdl": "^0.2.78",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
